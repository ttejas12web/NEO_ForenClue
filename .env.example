# ==============================================================================
# Transactional Email Configuration (Choose ANY of the options below)
# ==============================================================================

# Option A: Google Gmail SMTP with App Password (Easiest for direct inbox delivery)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=forenclue@gmail.com
GMAIL_APP_PASSWORD=

# Option B: Standard SMTP (Gmail, Brevo, SendGrid, Amazon SES, Mailgun, or Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=forenclue@gmail.com
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="ForenClue Security" <support@forenclue.in>

# Option C: Resend API (https://resend.com)
RESEND_API_KEY=
RESEND_FROM="ForenClue" <onboarding@resend.dev>

# Option D: SendGrid API (https://sendgrid.com)
SENDGRID_API_KEY=

# Option E: Brevo API (https://brevo.com)
BREVO_API_KEY=
